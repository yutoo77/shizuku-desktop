{
  "name": "shizuku-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "npm run build && electron .",
    "smoke": "node scripts/smoke.mjs",
    "soak": "node scripts/soak.mjs",
    "test:resources": "node scripts/resources.mjs",
    "test:context": "node scripts/context-recovery.mjs",
    "test:postures": "node scripts/postures.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@pixiv/three-vrm": "3.5.5",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "26.5.0",
    "@types/three": "0.185.4",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "typescript": "6.0.3"
  }
}
